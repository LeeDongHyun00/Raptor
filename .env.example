# --- AI (without a key the app runs in demo mode with sample responses) ---
ANTHROPIC_API_KEY=

# --- Naver trend sources (without keys, sample trend data is used) ---
# https://developers.naver.com : enable "데이터랩(검색어트렌드)" and "검색" APIs
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Storage (without these, a local JSON file under .data/ is used) ---
# Run supabase/schema.sql once in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel Cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=
